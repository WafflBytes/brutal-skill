<Project>
  <!-- Shared settings for every Sandbox tool (minimal BRUTAL project settings). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Override for other platforms: -p:BrutalRid=linux-x64 or the BrutalRid environment variable (CI's Linux job).
         Without one, Linux and macOS build for their own OS, so verify.ps1 there doesn't run win-x64 builds. -->
    <BrutalArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</BrutalArch>
    <BrutalRid Condition="'$(BrutalRid)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">linux-$(BrutalArch)</BrutalRid>
    <BrutalRid Condition="'$(BrutalRid)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">osx-$(BrutalArch)</BrutalRid>
    <BrutalRid Condition="'$(BrutalRid)' == ''">win-x64</BrutalRid>
    <RuntimeIdentifier>$(BrutalRid)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
