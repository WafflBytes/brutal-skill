<Project>
  <!-- Shared settings for every Sandbox tool (minimal BRUTAL project settings). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Override for other platforms: -p:BrutalRid=linux-x64 or the BrutalRid environment variable (CI's Linux job). -->
    <BrutalRid Condition="'$(BrutalRid)' == ''">win-x64</BrutalRid>
    <RuntimeIdentifier>$(BrutalRid)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
