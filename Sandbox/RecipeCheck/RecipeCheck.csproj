<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs skill recipes 7.1-7.8, 7.10 (Stb round trip), 7.11, 7.18-7.20 (SDL satellites) and 7.21 (ImGui), 7.35 and 7.36 (ImGui on SDL), 7.32 (OpenAL), 7.34 (Jolt constraints, compounds, characters) 7.37 (Localization) and T30 (OpenAL licence files). Exit code = number of failed recipes. -->
  <ItemGroup>
    <PackageReference Include="Ahwoo.BRUTAL.Core" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Logging" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Numerics" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Collections" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Concurrency" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Box2D" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.Jolt" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ShaderC" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Glfw" Version="2026.10.4" />
    <PackageReference Include="Ahwoo.BRUTAL.Stb" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.RakNet" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Gltf" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Vulkan" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Image" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Ttf" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Sdl.Mixer" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.ImGui.Backends" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenGl" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.BRUTAL.OpenAl" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.BRUTAL.Localization" Version="2026.10.2" />
  </ItemGroup>
  <!-- The licence-copy target from references/shipping.md (checked for OpenAL by T30). -->
  <Target Name="IncludeBrutalThirdPartyNotices" BeforeTargets="AssignTargetPaths" Condition="'$(NuGetPackageRoot)' != ''">
    <ItemGroup>
      <_BrutalPackage Include="@(PackageReference)" Condition="$([System.String]::Copy('%(Identity)').StartsWith('Ahwoo.BRUTAL.'))" />
      <_BrutalNotice Include="$(NuGetPackageRoot)$([System.String]::Copy('%(_BrutalPackage.Identity)').ToLowerInvariant())/%(_BrutalPackage.Version)/LICENSES/*.txt" />
      <!-- Some packages ship the same notice (ImGui and ImGui.Backends): copy each name once, or publish fails (NETSDK1152, T50). -->
      <_BrutalNoticeName Include="@(_BrutalNotice->'%(Filename)%(Extension)')" Source="%(_BrutalNotice.FullPath)" />
    </ItemGroup>
    <RemoveDuplicates Inputs="@(_BrutalNoticeName)">
      <Output TaskParameter="Filtered" ItemName="_BrutalNoticeOnce" />
    </RemoveDuplicates>
    <ItemGroup>
      <None Include="@(_BrutalNoticeOnce->'%(Source)')" Link="licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
